# Recommended: 64-character hex signing & encryption key (auto-generated in data/.secret_key if omitted)
OMNIBANNER_SECRET_KEY=

# Canonical externally reachable URL (used for OIDC redirect URIs & WordPress onboarding links)
OMNIBANNER_PUBLIC_URL=https://banners.example.com

# Persistent directory for SQLite database and generated secret key
OMNIBANNER_DATA_DIR=./data

# Optional database URL override (defaults to SQLite inside OMNIBANNER_DATA_DIR)
# OMNIBANNER_DATABASE_URL=sqlite:////app/data/omnibanner.db

